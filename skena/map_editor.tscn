[sub_resource type="GDScript" id="GDScript_ua5yk"]
resource_name = "input_grid"
script/source = "extends ColorRect

@export var map_editor : Control

func _input(event: InputEvent) -> void:
	if event is InputEventMouseMotion and map_editor.sedang_meni_transformasi and map_editor.handle_yang_digunakan:
		map_editor.posisi_kursor_di_viewport = event.position
		map_editor.nilai_transformasi = event.relative
"

