reflected_light_source = 1

[sub_resource type="GDScript" id="GDScript_b3t84"]
resource_name = "pengamat_viewport_depan"
script/source = "extends Camera3D

signal bergerak
signal sedang_fokus(aktif : bool)

#var fokus : bool = false
var fungsikan : bool = false
var drag_layar : bool = false

func _input(event):
	if not current or not fungsikan:
		return
		
	if drag_layar and event is InputEventMouseMotion:
		var gerak_dunia = Vector3(
			-event.relative.x,
			event.relative.y,
			0.0
		).normalized()
		get_parent().global_translate(gerak_dunia * (0.01 * size))
		emit_signal(\"bergerak\")
	
	if event is InputEventMouseButton:
		match event.button_index:
			MOUSE_BUTTON_RIGHT:
				drag_layar = event.pressed
				if not event.pressed: emit_signal(\"bergerak\")
			MOUSE_BUTTON_WHEEL_UP:
				size -= 0.5
				size = clampf(size, 1.0, 100.0)
				emit_signal(\"bergerak\")
			MOUSE_BUTTON_WHEEL_DOWN:
				size += 0.5
				size = clampf(size, 1.0, 100.0)
				emit_signal(\"bergerak\")
	
	#if Input.is_physical_key_pressed(KEY_TAB):
		#fokus = !fokus
		#emit_signal(\"sedang_fokus\", fokus)

func _process(delta):
	if not current or not fungsikan:
		return
	
	if not drag_layar:
		var direction = Vector3(
			float(Input.is_physical_key_pressed(KEY_D)) - float(Input.is_physical_key_pressed(KEY_A)),
			float(Input.is_physical_key_pressed(KEY_W)) - float(Input.is_physical_key_pressed(KEY_S)),
			0.0
		).normalized()
		
		if Input.is_physical_key_pressed(KEY_SHIFT): # boost
			get_parent().translate(direction * 5 * delta * 3.0)
		else:
			get_parent().translate(direction * 5 * delta)
		
		emit_signal(\"bergerak\")
"

